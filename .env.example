# Copia este archivo como .env y completa los valores localmente.
# Nunca publiques .env ni compartas GEMINI_API_KEY.

GEMINI_API_KEY=PEGA_AQUI_TU_API_KEY
GEMINI_KEY_ROTATED=false

# Modelo principal inicial. Podrás seleccionar uno compatible desde la GUI.
GEMINI_MODEL=gemini-3.5-flash-lite

# Preferencia inicial; Jarvis exige un verificador distinto y validado.
# Si este modelo no está disponible, el runtime selecciona otro compatible probado.
GEMINI_VERIFY_MODEL=gemini-2.5-flash

GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS_PER_MODEL=2
GEMINI_RETRY_DELAY_SECONDS=1
MAX_TASK_DURATION_SECONDS=180
MAX_SCREEN_ACTIONS=8
GEMINI_MODEL_DIAGNOSTICS_TTL_HOURS=168
